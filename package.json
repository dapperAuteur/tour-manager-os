    "@ai-sdk/react": "^3.0.195",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "ai": "^6.0.193",
    "langsmith": "^0.7.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.477.0",
    "next": "^15.5.28",
    "passkit-generator": "^3.5.7",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.364.4",
    "posthog-node": "^5.21.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "shippo": "^2.18.0",
    "stripe": "^21.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
